{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^beelink\\/images\\/nanobot\\/source\\.json$/"],
      "matchStrings": [
        "\"repository\":\\s*\"(?<depName>[^\"]+)\",\\s*\"commit\":\\s*\"(?<currentDigest>[a-f0-9]{40})\",\\s*\"version\":\\s*\"(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "currentValueTemplate": "v{{{version}}}",
      "autoReplaceStringTemplate": "\"repository\": \"{{{depName}}}\",\n  \"commit\": \"{{{newDigest}}}\",\n  \"version\": \"{{{replace '^v' '' newValue}}}\""
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(beelink|hetzner)\\/cluster\\/apps\\/.*\\.ya?ml$/",
      "/^shared\\/cluster\\/system-upgrade-controller\\/controller\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^shared\\/cluster\\/flux-system\\/gotk-components\\.ya?ml$/",
      "/^(beelink|hetzner)\\/cluster\\/infrastructure\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["shared/images/backups/Dockerfile"],
      "matchPackageNames": ["registry.k8s.io/kubectl", "restic/restic"],
      "automerge": true,
      "ignoreTests": true,
      "platformAutomerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["usefathom/fathom"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
