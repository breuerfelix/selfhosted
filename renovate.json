{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "coolify/**",
    "deprecated/**"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(beelink|hetzner)\\/cluster\\/apps\\/.*\\.ya?ml$/",
      "/^shared\\/cluster\\/system-upgrade-controller\\/controller\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^shared\\/cluster\\/flux-system\\/gotk-components\\.ya?ml$/",
      "/^(beelink|hetzner)\\/cluster\\/infrastructure\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes"],
      "matchPackageNames": [
        "ghcr.io/breuerfelix/nanobot"
      ],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["usefathom/fathom"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
