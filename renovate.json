{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": [
    "coolify/**",
    "deprecated/**"
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|\\/)portainer/[^/]+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^hetzner\\/cluster\\/apps\\/.*\\.ya?ml$/",
      "/^shared\\/cluster\\/system-upgrade-controller\\/controller\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^shared\\/cluster\\/flux-system\\/gotk-components\\.ya?ml$/",
      "/^hetzner\\/cluster\\/infrastructure\\/cert-manager\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["usefathom/fathom"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
