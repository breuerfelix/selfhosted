{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/build-nanobot\\.yml$/"],
      "matchStrings": [
        "NANOBOT_REF: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+) # renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)"
      ]
    }
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^(beelink|hetzner)\\/cluster\\/apps\\/.*\\.ya?ml$/",
      "/^shared\\/cluster\\/system-upgrade-controller\\/controller\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/^shared\\/cluster\\/flux-system\\/gotk-components\\.ya?ml$/",
      "/^(beelink|hetzner)\\/cluster\\/infrastructure\\/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "automerge": true,
      "ignoreTests": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["shared/images/backups/Dockerfile"],
      "matchPackageNames": ["registry.k8s.io/kubectl", "restic/restic"],
      "automerge": true,
      "ignoreTests": true,
      "platformAutomerge": false
    },
    {
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["beelink/cluster/apps/nanobot/app.yaml"],
      "matchPackageNames": ["ghcr.io/breuerfelix/nanobot"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "ignoreTests": true,
      "platformAutomerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["usefathom/fathom"],
      "versioning": "regex:^version-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
