// Managed by selfhosted/shared/ansible/roles/ubuntu_updates
// Define the complete shared policy instead of appending to distro defaults.
#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Allowed-Origins {
{% for origin in ubuntu_updates_allowed_origins %}
  "{{ origin }}";
{% endfor %}
};
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ ubuntu_updates_reboot_time }}";
